# Public frontend settings; these are embedded at build time.
VITE_CHAIN_ID=84532
VITE_RPC_URL=
# Empty means purchases are intentionally unavailable.
VITE_SEACASTER_ASSETS=

# Server settings. Never prefix private values with VITE_.
APP_ORIGIN=http://localhost:5173
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
# Local docker-compose database only. Leave empty for guest-only development.
DATABASE_URL=postgresql://seacaster:local-development-only@localhost:5432/seacaster
PORT=3001
NODE_ENV=development
TRUST_PROXY=0
