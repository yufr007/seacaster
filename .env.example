# SeaCaster public build settings. VITE_ values are embedded in the browser bundle.
VITE_CHAIN_ID=84532
VITE_RPC_URL=
# Empty means onchain checkout is intentionally disabled.
VITE_SEACASTER_ASSETS=

# Vercel Function settings. Never prefix private values with VITE_.
# Production: https://your-seacaster-domain.example
APP_ORIGIN=http://localhost:5173
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# Server-only PostgreSQL connection. In production use the fresh SeaCaster
# Supabase US-East transaction pooler connection string (SSL required).
DATABASE_URL=

NODE_ENV=development
