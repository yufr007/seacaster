# Never commit a real private key. Use a dedicated deployment signer locally.
DEPLOY_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
# Verify the official USDC token address separately for the selected chain.
PAYMENT_TOKEN=
TREASURY=
OWNER=
# HTTPS metadata endpoint with ERC-1155 {id} substitution.
METADATA_URI=
# Mainnet deployment is intentionally not enabled by default.
CONFIRM_MAINNET=
