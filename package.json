{
  "name": "seacaster", "version": "2.0.0", "private": true, "type": "module",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node --experimental-strip-types --env-file-if-exists=.env backend/src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --experimental-strip-types --env-file-if-exists=.env backend/src/server.ts",
    "test": "node --experimental-strip-types --test tests/engine.test.ts tests/cast.test.ts tests/assets.test.ts tests/world.test.ts tests/art.test.ts tests/art-motion.test.ts tests/deployment.test.ts",
    "test:api": "node --experimental-strip-types --test tests/api.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0", "@react-three/fiber": "8.18.0",
    "@tanstack/react-query": "^5.90.11", "@wagmi/core": "^2.22.1",
    "express": "^4.21.2", "lucide-react": "^0.555.0", "pg": "^8.16.3",
    "react": "18.3.1", "react-dom": "18.3.1", "three": "0.160.1",
    "viem": "^2.41.2", "wagmi": "^2.19.5", "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1", "@types/express": "^4.17.21", "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6", "@types/react": "^18.3.27", "@types/react-dom": "^18.3.7",
    "@types/three": "^0.160.0", "@vitejs/plugin-react": "^4.7.0", "typescript": "^5.9.3", "vite": "^7.3.1"
  }
}
